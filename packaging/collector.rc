#ifdef INTERNAL_TEST
#define PRODUCT_NAME "DeadlockLiveMatchCollectorInternalTest"
#else
#define PRODUCT_NAME "DeadlockLiveMatchCollector"
#endif
COLLECTOR ICON "collector.ico"
1 24 "collector.manifest"
1 VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "ProductName", PRODUCT_NAME "\0"
   VALUE "FileDescription", "Deadlock Live Collector\0"
   VALUE "OriginalFilename", "live-match-collector.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
